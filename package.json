{
  "name": "rulefiles",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Static site and weekly digest: what changed in AI coding tools, and which instruction file each agent reads.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "node scripts/validate-data.mjs",
    "build": "node scripts/build.mjs",
    "build:strict": "node scripts/build.mjs --strict",
    "test": "node --test tests/*.test.mjs",
    "check-links": "node scripts/check-links.mjs",
    "check-links:external": "node scripts/check-links.mjs --external",
    "indexnow": "node scripts/indexnow.mjs",
    "watch": "node scripts/watch.mjs",
    "watch:offline": "node scripts/watch.mjs --offline tests/fixtures --out /tmp/rulefiles-drafts",
    "preview": "node scripts/preview.mjs",
    "ci": "npm run validate && npm run build && npm test && npm run check-links"
  },
  "devDependencies": {
    "yaml": "2.9.1"
  }
}
